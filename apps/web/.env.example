# Leave empty for the key-free map. VITE_* values are visible to every browser.
# Use only a project-issued URL whose credentials are approved for public use.
VITE_HK_3D_TILESET_URL=

# Automated tests can suppress external basemap requests.
# VITE_MAP_BASEMAP=none

# Optional local profiling build only; keep off in normal/public builds.
# VITE_SCENE_DIAGNOSTICS=true
